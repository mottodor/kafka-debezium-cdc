#!/usr/bin/env bash
set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=scripts/lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
readonly LAB="$SCRIPT_DIR/lab"

usage() {
  cat <<'EOF'
Usage:
  scripts/check unit
  scripts/check smoke
  scripts/check acceptance AC-001
  scripts/check acceptance all

Acceptance checks publish redacted generation-scoped evidence under .runtime/evidence.
The all selector continues after ordinary AC failures, but aborts after an AC-007
runtime-restoration failure; any completed failure makes the command return nonzero.
EOF
}

consumer_python_version_probe() {
  docker run --rm --network none --read-only --tmpfs /tmp:size=16m \
    "$CONSUMER_IMAGE" \
    python -c 'import platform; actual = platform.python_version(); expected = "3.12.12"; assert actual == expected, f"expected Python {expected}, got {actual}"; print(f"python={actual}")'
}

detect_active_generation() {
  require_command python3
  python3 - <<'PY'
import json
from pathlib import Path

active = []
root = Path('.runtime/generations')
if root.is_dir():
    for path in root.glob('g[0-9][0-9][0-9]/manifest.json'):
        try:
            payload = json.loads(path.read_text(encoding='utf-8'))
        except (OSError, json.JSONDecodeError):
            continue
        if payload.get('state') == 'ACTIVE':
            active.append(path.parent.name)
if len(active) > 1:
    raise SystemExit(f"multiple ACTIVE generation manifests: {sorted(active)}")
print(active[0] if active else 'g001')
PY
}

active_consumer_state() {
  local generation="$1"
  if [[ "$generation" == "$DEFAULT_GENERATION" ]]; then
    service_state consumer
    return
  fi
  local container="cdc-lab-${generation}-consumer"
  if ! docker inspect "$container" >/dev/null 2>&1; then
    printf 'missing\n'
    return
  fi
  docker inspect --format '{{.State.Status}}' "$container"
}

running_inactive_consumers() {
  local active_generation="$1"
  local active_container="cdc-lab-${active_generation}-consumer"
  local name
  if [[ "$active_generation" != "$DEFAULT_GENERATION" \
    && "$(service_state consumer)" == "running" ]]; then
    printf '%s\n' "cdc-lab-g001-consumer-1"
  fi
  while IFS= read -r name; do
    [[ -n "$name" && "$name" != "$active_container" ]] || continue
    printf '%s\n' "$name"
  done < <(
    docker ps \
      --filter label=io.kafka-debezium-cdc.lab=cdc-lab \
      --filter label=io.kafka-debezium-cdc.role=generation-consumer \
      --format '{{.Names}}'
  )
}

wait_generation_status() {
  local generation="$1" attempt
  for attempt in {1..60}; do
    if "$LAB" status "$generation" >/dev/null 2>&1; then
      "$LAB" status "$generation"
      return
    fi
    sleep 2
  done
  fail "generation did not become ready: $generation" 1
}

unit_checks() {
  require_no_arguments "$@"
  require_command docker
  docker image inspect "$CONSUMER_IMAGE" >/dev/null 2>&1 \
    || fail "consumer image is unavailable; run scripts/lab pull" 69
  consumer_python_version_probe

  local output tests_run
  output="$(mktemp)"
  trap "rm -f -- '$output'" EXIT
  set +e
  docker run --rm \
    --network none \
    --read-only \
    --tmpfs /tmp:size=64m \
    --volume "$PROJECT_ROOT/consumer/src:/opt/cdc/consumer/src:ro" \
    --volume "$PROJECT_ROOT/consumer/tests:/opt/cdc/consumer/tests:ro" \
    --volume "$PROJECT_ROOT/tests:/opt/cdc/tests:ro" \
    --volume "$PROJECT_ROOT/fixtures:/opt/cdc/fixtures:ro" \
    --volume "$PROJECT_ROOT/scripts:/opt/cdc/scripts:ro" \
    --volume "$PROJECT_ROOT/config:/opt/cdc/config:ro" \
    --volume "$COMPOSE_FILE:/opt/cdc/compose.yaml:ro" \
    --env PYTHONPATH=/opt/cdc/consumer/src \
    --workdir /opt/cdc \
    "$CONSUMER_IMAGE" \
    python tests/run_offline.py \
    >"$output" 2>&1
  local status=$?
  set -e
  cat "$output"
  ((status == 0)) || fail "unit test command failed with exit status $status" "$status"
  tests_run="$(awk '/^Ran [0-9]+ tests? in / {print $2}' "$output" | tail -n 1)"
  [[ "$tests_run" =~ ^[0-9]+$ && "$tests_run" -gt 0 ]] \
    || fail "unit command did not execute a non-empty test suite" 1
  rm -f -- "$output"
  trap - EXIT
  printf 'unit checks passed tests=%s image=%s network=none\n' "$tests_run" "$CONSUMER_IMAGE"
}

smoke_cleanup_needed=0
smoke_cleanup() {
  local status=$?
  if ((smoke_cleanup_needed)); then
    printf 'restoring initial stopped service state; preserving volumes and network\n' >&2
    "$LAB" stop >/dev/null || true
  fi
  return "$status"
}

smoke_checks() {
  require_no_arguments "$@"
  require_command docker
  local active_generation core_running=0 active_state inactive_running
  local service
  active_generation="$(detect_active_generation)"
  for service in postgres kafka connect; do
    if [[ "$(service_state "$service")" == "running" ]]; then
      core_running=$((core_running + 1))
    fi
  done
  active_state="$(active_consumer_state "$active_generation")"
  inactive_running="$(running_inactive_consumers "$active_generation")"
  [[ -z "$inactive_running" ]] \
    || fail "smoke refuses running inactive generation consumers: $inactive_running" 69
  if ((core_running == 0)) && [[ "$active_state" != "running" ]]; then
    smoke_cleanup_needed=1
  elif ((core_running == 3)) && [[ "$active_state" == "running" ]]; then
    smoke_cleanup_needed=0
  else
    fail "smoke requires all core services and the active generation consumer either stopped or running; core=$core_running/3 generation=$active_generation consumer=$active_state" 69
  fi
  trap smoke_cleanup EXIT

  "$LAB" preflight
  "$LAB" up
  active_generation="$(detect_active_generation)"
  if [[ "$active_generation" == "$DEFAULT_GENERATION" ]]; then
    if ! "$LAB" status "$active_generation" >/dev/null 2>&1; then
      "$LAB" bootstrap "$active_generation"
    fi
  else
    "$LAB" resume "$active_generation"
  fi
  wait_generation_status "$active_generation"

  local postgres_version kafka_version
  postgres_version="$(
    compose exec --no-TTY postgres bash -Eeuo pipefail -c '
      psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --no-psqlrc \
        --tuples-only --no-align --command="SHOW server_version_num;"
    '
  )"
  [[ "$postgres_version" == "160013" ]] \
    || fail "unexpected PostgreSQL server_version_num: $postgres_version" 1

  kafka_version="$(compose exec --no-TTY kafka /kafka/bin/kafka-topics.sh --version)"
  [[ "$kafka_version" == *"4.3.0"* ]] \
    || fail "unexpected Kafka version: $kafka_version" 1

  compose exec --no-TTY connect python3 - <<'PY'
import json
from urllib.request import ProxyHandler, build_opener

opener = build_opener(ProxyHandler({}))
with opener.open("http://127.0.0.1:8083/connector-plugins", timeout=10) as response:
    plugins = json.load(response)
matching = [
    plugin
    for plugin in plugins
    if plugin.get("class") == "io.debezium.connector.postgresql.PostgresConnector"
]
if len(matching) != 1 or matching[0].get("version") != "3.6.3.Final":
    raise SystemExit(f"unexpected Debezium PostgreSQL plugin metadata: {matching!r}")
print("debezium-postgres=3.6.3.Final")
PY

  consumer_python_version_probe
  docker run --rm --network none --read-only --tmpfs /tmp:size=16m \
    "$CONSUMER_IMAGE" python /opt/cdc/consumer/check-runtime.py
  printf 'smoke checks passed generation=%s postgres=16.13 kafka=4.3.0 debezium=3.6.3.Final\n' \
    "$active_generation"
}

acceptance_checks() {
  (($# == 1)) || fail "usage: scripts/check acceptance <AC-001..AC-014|all>" 64
  local selector="$1"
  if [[ "$selector" != "all" && ! "$selector" =~ ^AC-0(0[1-9]|1[0-4])$ ]]; then
    fail "unknown acceptance selector: $selector" 64
  fi
  require_command python3
  python3 "$PROJECT_ROOT/tests/acceptance/run_acceptance.py" "$selector"
}

main() {
  (($# >= 1)) || { usage >&2; exit 64; }
  local command="$1"
  shift
  case "$command" in
    unit) unit_checks "$@" ;;
    smoke) smoke_checks "$@" ;;
    acceptance) acceptance_checks "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; fail "unknown check command: $command" 64 ;;
  esac
}

main "$@"
